<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MachineTestApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_group"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_group"
        android:supportsRtl="true"
        android:theme="@style/Theme.UserManagement">

        <!-- Splash Screen (Launcher) -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.UserManagement.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- User List Screen -->
        <activity
            android:name=".ui.users.UserListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- User Detail Screen -->
        <activity
            android:name=".ui.detail.UserDetailActivity"
            android:exported="false" />

    </application>

</manifest>
